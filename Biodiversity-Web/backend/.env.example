DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=biodiversity_db
DB_USER=biodiversity_app
DB_PASSWORD=change-me
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=28800

# Mobile app bearer tokens (seconds, max 86400). Native apps send no Origin header;
# list browser-preview origins of the Expo app here, comma-separated (e.g. http://localhost:8081).
MOBILE_TOKEN_SECONDS=43200
MOBILE_WEB_ORIGINS=

# Production: APP_ENV=production, HTTPS origin and secure cookies.
APP_ENV=development
# For remote MySQL, provide its trusted CA certificate.
DB_SSL_CA=

# Demonstration thresholds; calibrate with the device/conservation team before field use.
THREAT_DETECTION_ENABLED=true
THREAT_TEMPERATURE_LOW_CRITICAL=5
THREAT_TEMPERATURE_LOW_WARNING=10
THREAT_TEMPERATURE_HIGH_WARNING=35
THREAT_TEMPERATURE_HIGH_CRITICAL=40
THREAT_HUMIDITY_LOW_CRITICAL=15
THREAT_HUMIDITY_LOW_WARNING=30
THREAT_HUMIDITY_HIGH_WARNING=95
THREAT_HUMIDITY_HIGH_CRITICAL=99
THREAT_PROXIMITY_CRITICAL_CM=20
THREAT_PROXIMITY_WARNING_CM=50
THREAT_DISTANCE_CHANGE_WARNING_CM=30
THREAT_DISTANCE_CHANGE_CRITICAL_CM=80
THREAT_BASELINE_MAX_AGE_SECONDS=300
THREAT_COOLDOWN_SECONDS=300

# Private device credential; configure before accepting device uploads.
IOT_DEVICE_API_KEY=
