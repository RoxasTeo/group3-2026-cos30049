# The app talks to the shared PHP backend (Biodiversity-Web/backend/public). Restart Expo after changes.
# Development defaults to http://<your computer>:8080/api. Change only the port here:
# EXPO_PUBLIC_API_PORT=8080
# Or give the full address, including /api. For a phone, use your computer's Wi-Fi IPv4 address:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api
